DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_TOKEN is also accepted as a bot-token alias.

# Worker runtime secrets/vars:
DISCORD_PUBLIC_KEY=your_discord_public_key
SUPPORT_SERVER_URL=https://discord.gg/your-support-server
WEBSITE_URL=https://example.com
BOT_VERSION=development
DEVELOPER_DISCORD_USER_ID=your_discord_user_id
SUPPORT_REPORT_CHANNEL_ID=your_support_report_channel_id
