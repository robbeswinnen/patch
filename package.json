{
	"name": "patch-critical-ops-bot",
	"version": "1.0.0-recovered",
	"private": true,
	"description": "Recovered source for the Patch Critical Ops Discord bot",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"check": "pnpm run typecheck && pnpm run test",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"register": "node register.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@types/node": "^25.7.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@expo-google-fonts/jetbrains-mono": "0.4.1",
		"@resvg/resvg-wasm": "2.6.2",
		"discord-interactions": "4.4.0"
	}
}
