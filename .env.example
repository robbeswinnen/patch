DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_BOT_TOKEN=your_discord_bot_token
# The deployed Worker used DISCORD_TOKEN; DISCORD_BOT_TOKEN is the clearer preferred name.
# DISCORD_TOKEN=your_discord_bot_token

# Worker runtime secrets/vars:
DISCORD_PUBLIC_KEY=your_discord_public_key
SUPPORT_SERVER_URL=https://discord.gg/your-support-server
WEBSITE_URL=https://example.com
DEVELOPER_DISCORD_USER_IDS=developer_id_1,developer_id_2
SUPPORT_REPORT_CHANNEL_ID=your_support_report_channel_id
PATCH_INVITE_URL=https://discord.com/oauth2/authorize?client_id=your_application_id
PROMO_KIT_URL=https://example.com/patch-promo-kit
REPORT_DM_IMAGE_URL=https://example.com/report-banner.png
