/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "discord-bot",
	"main": "src/index.ts",
	// Pinned to the active Cloudflare deployment recovered on 2026-08-15.
	"compatibility_date": "2026-05-13",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	// Preserve dashboard-managed staff configuration and encrypted secrets.
	"keep_vars": true,
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"SUPPORT_SERVER_URL": "https://discord.gg/QW7CZczhT4",
		"WEBSITE_URL": "https://discord-bot.robbeswinnen.workers.dev",
	},
	// Staff IDs remain dashboard-managed; see docs/CLOUDFLARE_VARIABLES.md.
	"kv_namespaces": [
		{
			"binding": "USER_PREFERENCES",
			"id": "f5a530cf25f94e49b6635d0e4ba07fe4",
			"remote": true,
		},
	],
	"triggers": {
		"crons": ["0 * * * *"],
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.css", "**/*.client.js"],
			"fallthrough": true,
		},
		{
			"type": "Data",
			"globs": ["**/*.ttf", "**/*.png", "**/*.jpg", "**/*.jpeg"],
			"fallthrough": true,
		},
	],
}
